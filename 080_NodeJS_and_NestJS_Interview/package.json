    "010": "npx ts-node --transpile-only 010_nestjs_di/main.ts",
    "011": "npx ts-node --transpile-only 011_nestjs_pipeline/main.ts",
    "012": "npx ts-node --transpile-only 012_nestjs_decorators/main.ts",
    "013": "npx ts-node --transpile-only 013_nestjs_dynamic_lifecycle/main.ts",
    "014": "npx ts-node --transpile-only 014_nestjs_advanced/main.ts",
